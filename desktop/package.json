{
  "name": "clipshots-desktop",
  "productName": "Clipshots",
  "version": "0.1.0",
  "description": "Clipshots desktop: live highlight catcher for esports broadcasts",
  "author": "Cutscene Creative <info@cutscenecreative.com>",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --config ui/vite.config.mts",
    "typecheck": "tsc --noEmit -p ui && tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "fetch-bins": "node scripts/fetch-ytdlp.mjs",
    "dist": "npm run build && npm run fetch-bins && electron-builder",
    "test:e2e": "npm run build && node test/e2e.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.7",
    "lucide-react": "^1.71.0",
    "playwright-core": "^1.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
