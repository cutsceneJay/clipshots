{
  "name": "clipshots-core",
  "private": true,
  "type": "module",
  "description": "Shared moment-detection core, tests and proofs. The app itself lives in desktop/.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:footage": "bash scripts/make-test-footage.sh",
    "proof:scan": "tsx test/proofs/scan-proof.ts",
    "proof:live": "tsx test/proofs/scan-proof.ts test/fixtures/test120.mp4 --live",
    "proof:srt": "tsx test/proofs/srt-proof.ts",
    "proof:vod": "tsx test/proofs/vod-proof.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
